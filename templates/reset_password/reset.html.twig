{# templates/reset_password/reset.html.twig #}
{% extends 'base.html.twig' %}
{% form_theme resetForm 'form/floating_labels.html.twig' %}

{% block title %}Conventio — Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-10">
        <div class="w-full max-w-md">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
                <h1 class="text-2xl font-bold text-gray-900 mb-6 text-center">Nouveau mot de passe</h1>

                {{ form_start(resetForm, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}
                    {{ form_row(resetForm.plainPassword) }}
                    <p class="text-xs text-gray-500">
                        12 caractères minimum, suffisamment complexe (recommandation CNIL).
                    </p>
                    <button type="submit"
                            class="w-full py-3 px-4 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                        Réinitialiser le mot de passe
                    </button>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </main>
{% endblock %}
