{# templates/you_trust_test/list.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}YouTrust — Liste des demandes de signature{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-10">
    <div class="max-w-6xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Demandes de signature</h1>
        <p class="text-gray-600 mb-6">Liste des demandes créées via l'API YouTrust.</p>

        {% include 'you_trust_test/_nav.html.twig' with { current: 'test_you_trust_list' } %}
        {% include 'you_trust_test/_flashes.html.twig' %}

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="bg-gray-50 rounded-lg p-4 text-center">
                    <div class="text-2xl font-bold text-indigo-600">{{ signatureRequests|length }}</div>
                    <div class="text-sm text-gray-500">Total</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4 text-center">
                    <div class="text-2xl font-bold text-green-600">
                        {{ signatureRequests|filter(sr => sr.status == 'activated')|length }}
                    </div>
                    <div class="text-sm text-gray-500">Activées</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4 text-center">
                    <div class="text-2xl font-bold text-amber-600">
                        {{ signatureRequests|filter(sr => sr.status == 'draft')|length }}
                    </div>
                    <div class="text-sm text-gray-500">Brouillons</div>
                </div>
            </div>

            {% if signatureRequests|length == 0 %}
                <div class="text-center py-12 text-gray-500">
                    <p class="mb-4">Aucune demande de signature trouvée.</p>
                    <a href="{{ path('test_you_trust_index') }}"
                       class="inline-block py-2 px-4 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition">
                        Créer une première demande
                    </a>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">#</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nom</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID externe</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Statut</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Créée le</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Documents</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Signataires</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for sr in signatureRequests %}
                                {% set badge = {
                                    draft: 'bg-amber-100 text-amber-800',
                                    activated: 'bg-green-100 text-green-800',
                                    ongoing: 'bg-green-100 text-green-800',
                                    approval: 'bg-blue-100 text-blue-800',
                                    completed: 'bg-indigo-100 text-indigo-800',
                                    cancelled: 'bg-red-100 text-red-800',
                                    expired: 'bg-gray-100 text-gray-800'
                                } %}
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3 text-sm text-gray-500">{{ loop.index }}</td>
                                    <td class="px-4 py-3 text-sm"><code class="font-mono text-xs text-gray-700">{{ sr.id|default('N/A') }}</code></td>
                                    <td class="px-4 py-3 text-sm text-gray-900">
                                        <strong>{{ sr.name|default('N/A')|slice(0, 30) }}{% if sr.name|default('')|length > 30 %}...{% endif %}</strong>
                                        {% if sr.external_id %}
                                            <br><span class="text-xs text-gray-500">Ext : {{ sr.external_id|slice(0, 20) }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ sr.external_id|default('N/A')|slice(0, 15) }}</td>
                                    <td class="px-4 py-3 text-sm">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold {{ badge[sr.status|lower|default('unknown')]|default('bg-gray-100 text-gray-800') }}">
                                            {{ sr.status|default('Inconnu') }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700">
                                        {% if sr.created_at %}
                                            {{ sr.created_at|date('d/m/Y H:i') }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ sr.documents is defined ? sr.documents|length : 0 }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ sr.signers is defined ? sr.signers|length : 0 }}</td>
                                    <td class="px-4 py-3 text-sm whitespace-nowrap">
                                        <a href="{{ path('api_you_trust_get_signature_request', { signatureRequestId: sr.id }) }}"
                                           class="inline-block mr-1 px-2 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-medium hover:bg-indigo-100"
                                           title="Voir le détail (API)">
                                            Voir
                                        </a>
                                        {% if sr.status == 'draft' %}
                                            <form method="post" action="{{ path('test_you_trust_activate_signature_request', { signatureRequestId: sr.id }) }}" class="inline-block"
                                                  onsubmit="return confirm('Activer cette demande de signature ?')">
                                                <button type="submit" class="mr-1 px-2 py-1 rounded-lg bg-green-600 text-white text-xs font-medium hover:bg-green-700" title="Activer">
                                                    Activer
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if sr.status == 'approval' or sr.status == 'ongoing' %}
                                            <form method="post" action="{{ path('test_you_trust_cancel_signature_request', { signatureRequestId: sr.id }) }}" class="inline-block"
                                                  onsubmit="return confirm('Annuler cette demande de signature ? Elle ne pourra plus être réactivée.')">
                                                <button type="submit" class="mr-1 px-2 py-1 rounded-lg bg-red-600 text-white text-xs font-medium hover:bg-red-700" title="Annuler">
                                                    Annuler
                                                </button>
                                            </form>
                                        {% endif %}
                                        {% if sr.status != 'approval' and sr.status != 'ongoing' %}
                                            <form method="post" action="{{ path('test_you_trust_delete_signature_request', { signatureRequestId: sr.id }) }}" class="inline-block"
                                                  onsubmit="return confirm('Supprimer cette demande de signature ? Cette action est irréversible.')">
                                                <button type="submit" class="px-2 py-1 rounded-lg bg-gray-600 text-white text-xs font-medium hover:bg-gray-700" title="Supprimer">
                                                    Supprimer
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>
    </div>
</main>
{% endblock %}
