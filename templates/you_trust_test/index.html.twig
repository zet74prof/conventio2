{# templates/you_trust_test/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}YouTrust — Créer une demande de signature{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-10">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">YouTrust — Création d'une demande de signature</h1>
        <p class="text-gray-600 mb-6">Page de test du service YouTrust (environnement sandbox).</p>

        {% include 'you_trust_test/_nav.html.twig' with { current: 'test_you_trust_index' } %}
        {% include 'you_trust_test/_flashes.html.twig' %}

        {% if not isConfigured %}
            <div class="border border-red-200 bg-red-50 text-red-800 rounded-lg p-4 mb-6 text-sm" role="alert">
                L'API YouTrust n'est pas configurée. Définissez <code class="font-mono">YOU_TRUST_API_KEY</code> dans votre fichier <code class="font-mono">.env</code>.
            </div>
        {% endif %}

        <form action="{{ path('test_you_trust_create_signature_request') }}" method="post" enctype="multipart/form-data" class="space-y-6">
            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-1">Informations générales</h2>
                <p class="text-sm text-gray-500 mb-4">Les champs marqués d'un * sont requis.</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="name">Nom *</label>
                        <input type="text" id="name" name="name" value="Convention de stage - {{ 'now'|date('Y-m-d H:i') }}" required
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="external_id">ID externe</label>
                        <input type="text" id="external_id" name="external_id" value="conv_{{ 'now'|date('YmdHis') }}" placeholder="Référence externe facultative"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="custom_name">Nom de l'expéditeur *</label>
                    <input type="text" id="custom_name" name="custom_name" value="Lycée Gabriel Fauré" required
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="request_subject">Objet de l'e-mail *</label>
                        <input type="text" id="request_subject" name="request_subject" value="Convention de stage de xxxx à signer" required
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="reminder_subject">Objet du rappel *</label>
                        <input type="text" id="reminder_subject" name="reminder_subject" value="[Rappel] : Convention de stage de xxxx à signer" required
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="request_body">Corps de l'e-mail *</label>
                        <textarea id="request_body" name="request_body" required rows="4"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">Merci d'accueillir tel étudiant et de signer sa convention de stage</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="reminder_body">Corps du rappel *</label>
                        <textarea id="reminder_body" name="reminder_body" required rows="4"
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">Vous n'avez pas eu le temps de signer ?</textarea>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="timezone">Fuseau horaire</label>
                        <select id="timezone" name="timezone"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="Europe/Paris" selected>Europe/Paris</option>
                            <option value="UTC">UTC</option>
                            <option value="Europe/London">Europe/London</option>
                            <option value="America/New_York">America/New_York</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="audit_trail_locale">Langue de la piste d'audit</label>
                        <select id="audit_trail_locale" name="audit_trail_locale"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="fr" selected>Français (fr)</option>
                            <option value="en">English (en)</option>
                            <option value="es">Español (es)</option>
                            <option value="de">Deutsch (de)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="delivery_mode">Mode d'envoi</label>
                        <select id="delivery_mode" name="delivery_mode"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="email" selected>E-mail</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="smart_anchors_resolution">Résolution des ancres</label>
                        <select id="smart_anchors_resolution" name="smart_anchors_resolution"
                                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                            <option value="on_activation" selected>À l'activation</option>
                            <option value="on_upload">À l'upload</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="reminder_interval_in_days">Intervalle de rappel (jours)</label>
                        <input type="number" id="reminder_interval_in_days" name="reminder_interval_in_days" value="1" min="1" max="30"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="max_reminder_occurrences">Nombre max de rappels</label>
                        <input type="number" id="max_reminder_occurrences" name="max_reminder_occurrences" value="5" min="1" max="20"
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" id="ordered_signers" name="ordered_signers" value="1" checked class="accent-indigo-600">
                            Signataires ordonnés
                        </label>
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" id="signers_allowed_to_decline" name="signers_allowed_to_decline" value="1" class="accent-indigo-600">
                            Refus autorisé
                        </label>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-1">Document</h2>
                <p class="text-sm text-gray-500 mb-4">Téléversez le document PDF à faire signer.</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1" for="document">Document PDF *</label>
                        <input type="file" id="document" name="document" accept=".pdf" required
                               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1 file:text-indigo-700 hover:file:bg-indigo-100">
                        <p class="text-xs text-gray-500 mt-1">Seuls les fichiers PDF sont acceptés.</p>
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" id="parse_anchors" name="parse_anchors" value="1" checked class="accent-indigo-600">
                            Analyser les ancres de signature
                        </label>
                    </div>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-1">Signataires ({{ defaultSigners|length }})</h2>
                <p class="text-sm text-gray-500 mb-4">Ajoutez au moins un signataire. Prénom, nom et e-mail sont requis pour chacun.</p>

                <div data-controller="signers" data-signers-count-value="{{ defaultSigners|length }}">
                    <input type="hidden" name="signer_count" id="signer_count" data-signers-target="count" value="{{ defaultSigners|length }}">

                    <div data-signers-target="container" class="space-y-4">
                        {% for i, signer in defaultSigners %}
                            {% include 'you_trust_test/_signer_row.html.twig' with { index: i, signer: signer } %}
                        {% endfor %}
                    </div>

                    <template data-signers-target="template">
                        {% include 'you_trust_test/_signer_row.html.twig' with { index: '__INDEX__', signer: [] } %}
                    </template>

                    <button type="button"
                            data-action="signers#add"
                            class="mt-4 px-4 py-2 rounded-lg border border-indigo-600 text-indigo-600 text-sm font-medium hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                        + Ajouter un signataire
                    </button>
                </div>
            </section>

            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Options d'envoi</h2>

                <label class="flex items-center gap-2 text-sm text-gray-700">
                    <input type="checkbox" id="activate_immediately" name="activate_immediately" value="1" checked class="accent-indigo-600">
                    Activer la demande de signature immédiatement
                </label>
                <p class="text-xs text-gray-500 mt-2">
                    Si cette case est décochée, la demande reste en brouillon et devra être activée manuellement depuis la liste.
                </p>
            </section>

            <div class="text-center">
                <button type="submit"
                        class="py-3 px-8 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                    Créer la demande de signature
                </button>
            </div>
        </form>
    </div>
</main>
{% endblock %}
