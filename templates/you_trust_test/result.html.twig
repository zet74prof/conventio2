{# templates/you_trust_test/result.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}YouTrust — Demande créée{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-10">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Demande de signature créée</h1>
        <p class="text-gray-600 mb-6">Résultat renvoyé par l'API YouTrust.</p>

        {% include 'you_trust_test/_nav.html.twig' with { current: '' } %}
        {% include 'you_trust_test/_flashes.html.twig' %}

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Résumé</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">Nom</div>
                    <div class="font-semibold text-gray-900 break-all">{{ result.name|default('N/A') }}</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">ID externe</div>
                    <div class="font-semibold text-gray-900 break-all">{{ result.external_id|default('N/A') }}</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">Statut</div>
                    <div class="font-semibold text-gray-900">{{ result.status|default('N/A') }}</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">ID de la demande</div>
                    <div class="font-mono text-sm text-gray-900 break-all">{{ result.id|default('N/A') }}</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">Signataires</div>
                    <div class="font-semibold text-gray-900">{{ config.signer_count|default(0) }}</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-4">
                    <div class="text-sm text-gray-500 mb-1">Documents</div>
                    <div class="font-semibold text-gray-900">{{ result.documents is defined ? result.documents|length : 0 }}</div>
                </div>
            </div>
        </section>

        {% if result.documents is defined and result.documents|length > 0 %}
            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Documents</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">#</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nom</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nature</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Statut</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for document in result.documents %}
                                <tr>
                                    <td class="px-4 py-3 text-sm text-gray-500">{{ loop.index }}</td>
                                    <td class="px-4 py-3 text-sm"><code class="font-mono text-xs text-gray-700">{{ document.id|default('N/A') }}</code></td>
                                    <td class="px-4 py-3 text-sm text-gray-900">{{ document.name|default('N/A') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ document.nature|default('N/A') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ document.status|default('N/A') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endif %}

        {% if result.signers is defined and result.signers|length > 0 %}
            <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
                <h2 class="text-lg font-semibold text-gray-900 mb-4">Signataires</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead>
                            <tr class="bg-gray-50">
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">#</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">ID</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Nom</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">E-mail</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Téléphone</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Statut</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase">Ordre</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {% for signer in result.signers %}
                                <tr>
                                    <td class="px-4 py-3 text-sm text-gray-500">{{ loop.index }}</td>
                                    <td class="px-4 py-3 text-sm"><code class="font-mono text-xs text-gray-700">{{ signer.id|default('N/A') }}</code></td>
                                    <td class="px-4 py-3 text-sm text-gray-900">{{ signer.first_name|default('') }} {{ signer.last_name|default('') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ signer.email|default('N/A') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ signer.phone_number|default('N/A') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ signer.status|default('N/A') }}</td>
                                    <td class="px-4 py-3 text-sm text-gray-700">{{ signer.info.signing_order|default('N/A') }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        {% endif %}

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6"
                 data-controller="clipboard">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-gray-900">Réponse API complète</h2>
                <button type="button"
                        data-action="clipboard#copy"
                        class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-medium hover:bg-indigo-700 transition">
                    Copier le JSON
                </button>
            </div>
            <pre data-clipboard-target="source"
                 class="bg-gray-900 text-gray-100 rounded-lg p-4 text-xs overflow-x-auto max-h-80 overflow-y-auto font-mono">{{ result|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        </section>

        <div class="flex flex-wrap gap-3">
            <a href="{{ path('test_you_trust_index') }}"
               class="py-2 px-4 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition">
                Créer une autre demande
            </a>
            <a href="{{ path('test_you_trust_list') }}"
               class="py-2 px-4 rounded-lg border border-indigo-600 text-indigo-600 text-sm font-medium hover:bg-indigo-50 transition">
                Voir toutes les demandes
            </a>
        </div>
    </div>
</main>
{% endblock %}
