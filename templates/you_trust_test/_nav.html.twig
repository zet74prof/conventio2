{# Navigation commune aux pages de test YouTrust. `current` = nom de la route active. #}
{% set current = current|default('') %}
{% set links = [
    { route: 'test_you_trust_index', label: 'Créer une demande' },
    { route: 'test_you_trust_list', label: 'Liste des demandes' },
    { route: 'test_you_trust_ping', label: 'Ping API' },
    { route: 'test_you_trust_upload_test', label: 'Test d\'upload' },
] %}

<nav class="flex flex-wrap gap-2 mb-8">
    {% for link in links %}
        <a href="{{ path(link.route) }}"
           class="px-3 py-2 rounded-lg text-sm font-medium border transition
                  {% if current == link.route %}
                      bg-indigo-600 text-white border-indigo-600
                  {% else %}
                      bg-white text-gray-700 border-gray-200 hover:bg-gray-100
                  {% endif %}">
            {{ link.label }}
        </a>
    {% endfor %}
</nav>
