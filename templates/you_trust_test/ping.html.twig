{# templates/you_trust_test/ping.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}YouTrust — Ping API{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-10">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Test de connectivité API</h1>
        <p class="text-gray-600 mb-6">Vérifie la configuration du service YouTrust.</p>

        {% include 'you_trust_test/_nav.html.twig' with { current: 'test_you_trust_ping' } %}
        {% include 'you_trust_test/_flashes.html.twig' %}

        {% if error is defined %}
            <div class="border border-red-200 bg-red-50 text-red-800 rounded-lg p-4 mb-6 text-sm" role="alert">
                Échec de connexion : {{ error }}
            </div>
        {% endif %}

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Configuration de l'API YouTrust</h2>

            <dl class="divide-y divide-gray-100">
                <div class="flex justify-between gap-4 py-3">
                    <dt class="text-sm font-medium text-gray-700">URL de l'API</dt>
                    <dd class="text-sm font-mono text-gray-900 break-all text-right">{{ config.apiUrl|default('Non configurée') }}</dd>
                </div>
                <div class="flex justify-between gap-4 py-3">
                    <dt class="text-sm font-medium text-gray-700">Version de l'API</dt>
                    <dd class="text-sm font-mono text-gray-900">{{ config.apiVersion|default('Non configurée') }}</dd>
                </div>
                <div class="flex justify-between gap-4 py-3">
                    <dt class="text-sm font-medium text-gray-700">Clé API</dt>
                    <dd class="text-sm text-gray-900">
                        {% if config.apiKey|default('') is not empty %}
                            <span class="text-green-700 font-medium">Configurée (masquée)</span>
                        {% else %}
                            <span class="text-red-700 font-medium">Non configurée</span>
                        {% endif %}
                    </dd>
                </div>
                <div class="flex justify-between gap-4 py-3">
                    <dt class="text-sm font-medium text-gray-700">Timeout</dt>
                    <dd class="text-sm font-mono text-gray-900">{{ config.timeout|default(30) }} s</dd>
                </div>
            </dl>

            <div class="mt-4">
                {% if isConfigured %}
                    <span class="inline-flex px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800">API configurée</span>
                {% else %}
                    <span class="inline-flex px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800">API non configurée</span>
                {% endif %}
            </div>
        </section>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Instructions de configuration</h2>
            <p class="text-sm text-gray-600 mb-3">Ajoutez ceci à votre fichier <code class="font-mono text-xs bg-gray-100 px-1 py-0.5 rounded">.env</code> :</p>
            <pre class="bg-gray-900 text-gray-100 rounded-lg p-4 text-xs overflow-x-auto font-mono"># Configuration de l'API YouTrust
YOU_TRUST_API_URL=https://api-sandbox.yousign.app
YOU_TRUST_API_KEY=your_api_key_here
YOU_TRUST_API_VERSION=v3
YOU_TRUST_TIMEOUT=30</pre>
            <p class="text-sm text-gray-600 mt-3">
                En production, utilisez <code class="font-mono text-xs bg-gray-100 px-1 py-0.5 rounded">https://api.yousign.app</code> et votre clé de production.
                Pensez à vider le cache Symfony (<code class="font-mono text-xs bg-gray-100 px-1 py-0.5 rounded">php bin/console cache:clear</code>) après modification.
            </p>
        </section>

        <a href="{{ path('test_you_trust_index') }}"
           class="inline-block py-2 px-4 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition">
            ← Retour au formulaire de test
        </a>
    </div>
</main>
{% endblock %}
