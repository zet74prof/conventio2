{# templates/you_trust_test/upload_test.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}YouTrust — Test d'upload{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-10">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Test d'upload de fichier</h1>
        <p class="text-gray-600 mb-6">Vérifie que le serveur accepte correctement les envois de fichiers.</p>

        {% include 'you_trust_test/_nav.html.twig' with { current: 'test_you_trust_upload_test' } %}
        {% include 'you_trust_test/_flashes.html.twig' %}

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Envoyer un fichier de test</h2>

            <form action="{{ path('test_you_trust_upload_test') }}" method="post" enctype="multipart/form-data"
                  data-controller="upload">
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1" for="test_file">Fichier à envoyer</label>
                    <input type="file" id="test_file" name="test_file" accept=".pdf,.doc,.docx,.txt" required
                           data-upload-target="input"
                           data-action="change->upload#choose"
                           class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-indigo-50 file:px-3 file:py-1 file:text-indigo-700 hover:file:bg-indigo-100">
                </div>

                <div data-upload-target="dropzone"
                     data-action="dragover->upload#dragOver dragleave->upload#dragLeave drop->upload#drop click->upload#pick"
                     class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center bg-gray-50 cursor-pointer transition hover:bg-indigo-50 hover:border-indigo-400">
                    <p class="font-medium text-gray-900" data-upload-target="label">Glissez un fichier ici ou cliquez pour parcourir</p>
                    <p class="text-xs text-gray-500 mt-1">PDF, DOC, DOCX, TXT — 10 Mo max</p>
                </div>

                <input type="hidden" name="MAX_FILE_SIZE" value="10485760">

                <div class="text-center mt-6">
                    <button type="submit"
                            class="py-2 px-6 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                        Envoyer le fichier
                    </button>
                </div>
            </form>
        </section>

        <section class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Prérequis d'upload</h2>
            <dl class="divide-y divide-gray-100 text-sm">
                <div class="flex justify-between gap-4 py-2">
                    <dt class="font-medium text-gray-700">Formats acceptés</dt>
                    <dd class="text-gray-900">PDF, DOC, DOCX, TXT</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="font-medium text-gray-700">Taille maximale</dt>
                    <dd class="text-gray-900">10 Mo</dd>
                </div>
                <div class="flex justify-between gap-4 py-2">
                    <dt class="font-medium text-gray-700">Pour YouTrust</dt>
                    <dd class="text-gray-900">PDF recommandé pour les ancres de signature</dd>
                </div>
            </dl>
        </section>

        <a href="{{ path('test_you_trust_index') }}"
           class="inline-block py-2 px-4 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition">
            ← Retour au formulaire principal
        </a>
    </div>
</main>
{% endblock %}
