{# templates/you_trust_test/_signer_row.html.twig #}
{% if index is not defined %}
    {% set index = 0 %}
{% endif %}

<div class="signer-box" id="signer_box_{{ index }}">
    <div class="signer-header">
        <span class="signer-index">{{ index + 1 }}</span>
        <h3>Signer {{ index + 1 }}</h3>
        <button type="button" onclick="removeSigner({{ index }})" 
                style="background: none; border: none; color: #e74c3c; cursor: pointer; font-size: 20px;">
            ×
        </button>
    </div>
    
    <div class="grid-2">
        <div class="form-group">
            <label>First Name *</label>
            <input type="text" name="signer_{{ index }}_first_name" 
                   value="{{ signer.first_name|default('') }}" required>
        </div>
        <div class="form-group">
            <label>Last Name *</label>
            <input type="text" name="signer_{{ index }}_last_name" 
                   value="{{ signer.last_name|default('') }}" required>
        </div>
    </div>
    
    <div class="grid-2">
        <div class="form-group">
            <label>Email *</label>
            <input type="email" name="signer_{{ index }}_email" 
                   value="{{ signer.email|default('') }}" required>
        </div>
        <div class="form-group">
            <label>Phone Number *</label>
            <input type="tel" name="signer_{{ index }}_phone_number" 
                   value="{{ signer.phone_number|default('') }}" 
                   placeholder="+33612345678" required>
        </div>
    </div>
    
    <div class="grid-4">
        <div class="form-group">
            <label>Locale</label>
            <select name="signer_{{ index }}_locale">
                <option value="fr" {% if signer.locale|default('fr') == 'fr' %}selected{% endif %}>Français</option>
                <option value="en" {% if signer.locale|default('fr') == 'en' %}selected{% endif %}>English</option>
                <option value="es" {% if signer.locale|default('fr') == 'es' %}selected{% endif %}>Español</option>
                <option value="de" {% if signer.locale|default('fr') == 'de' %}selected{% endif %}>Deutsch</option>
            </select>
        </div>
        <div class="form-group">
            <label>Signature Level</label>
            <select name="signer_{{ index }}_signature_level">
                <option value="electronic_signature" {% if signer.signature_level|default('electronic_signature') == 'electronic_signature' %}selected{% endif %}>Electronic</option>
            </select>
        </div>
        <div class="form-group">
            <label>Delivery Mode</label>
            <select name="signer_{{ index }}_delivery_mode">
                <option value="email" {% if signer.delivery_mode|default('email') == 'email' %}selected{% endif %}>Email</option>
            </select>
        </div>
        <div class="form-group">
            <label>Auth Mode</label>
            <select name="signer_{{ index }}_signature_authentication_mode">
                <option value="otp_sms" {% if signer.signature_authentication_mode|default('otp_sms') == 'otp_sms' %}selected{% endif %}>OTP SMS</option>
                <option value="otp_email" {% if signer.signature_authentication_mode|default('otp_sms') == 'otp_email' %}selected{% endif %}>OTP Email</option>
            </select>
        </div>
    </div>
</div>
