{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Conventio — S'enregistrer{% endblock %}

{% block body %}
    <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-10">
        <div class="w-full max-w-md">
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
                <h1 class="text-2xl font-bold text-gray-900 mb-6 text-center">S'enregistrer</h1>

                {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
                    {{ form_row(registrationForm.email, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_row(registrationForm.plainPassword, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}

                    <button type="submit"
                            class="w-full py-3 px-4 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                        S'enregistrer
                    </button>
                {{ form_end(registrationForm) }}

                <p class="mt-4 text-sm text-gray-600 text-center">
                    Déjà un compte ?
                    <a href="{{ path('app_login') }}" class="text-indigo-600 font-medium hover:underline">Se connecter</a>
                </p>
            </div>
        </div>
    </main>
{% endblock %}
