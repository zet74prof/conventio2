{# templates/home/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Conventio — Accueil{% endblock %}

{% block body %}
    <main class="min-h-screen flex items-center justify-center bg-gray-50 px-4 py-10"
          data-controller="demo"
          data-demo-count-value="0"
          data-demo-step-value="1">
        <div class="w-full max-w-md text-center">
            <h1 data-demo-target="title" class="text-4xl font-bold text-gray-900 mb-2 transition-colors duration-300">Conventio</h1>
            <p class="text-gray-600 mb-10">La plateforme de gestion des conventions de stage</p>

            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 space-y-4">
                {# Temporary links — login/register controllers do not exist yet #}
                <a href="/login"
                   class="block w-full py-3 px-4 rounded-lg bg-indigo-600 text-white font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                    Se connecter
                </a>
                <a href="/register"
                   class="block w-full py-3 px-4 rounded-lg border border-indigo-600 text-indigo-600 font-medium hover:bg-indigo-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition">
                    Créer un compte
                </a>
            </div>

            {# Stimulus demo — pedagogical widget for students #}
            <section class="mt-8 bg-gray-900 rounded-xl p-4 text-left shadow-sm">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-white font-semibold text-sm">🧪 Labo Stimulus</h2>
                    <code class="text-xs text-gray-500">demo_controller.js</code>
                </div>

                {# Compteur : targets + actions + values #}
                <div class="flex items-center justify-center gap-3 mb-4">
                    <button type="button"
                            data-action="click->demo#decrement"
                            class="w-10 h-10 rounded-lg bg-gray-700 text-white text-xl font-bold hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                        −
                    </button>
                    <span data-demo-target="output"
                          class="text-4xl font-mono font-bold text-white w-20 text-center tabular-nums">0</span>
                    <button type="button"
                            data-action="click->demo#increment"
                            class="w-10 h-10 rounded-lg bg-gray-700 text-white text-xl font-bold hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                        +
                    </button>
                    <button type="button"
                            data-action="click->demo#reset"
                            class="px-3 h-10 rounded-lg bg-gray-700 text-gray-300 text-sm hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition">
                        Reset
                    </button>
                </div>

                {# Value réactive : le pas du compteur, modifiable via un range #}
                <div class="flex items-center gap-3 mb-4 text-sm">
                    <label for="demo-step" class="text-gray-300 shrink-0">Pas :</label>
                    <input id="demo-step" type="range" min="1" max="10" value="1"
                           data-action="input->demo#updateStep"
                           class="flex-1 accent-indigo-500">
                    <span data-demo-target="stepDisplay" class="text-white font-mono w-6 text-center tabular-nums">1</span>
                </div>

                <button type="button"
                        data-action="click->demo#randomColor"
                        class="w-full mb-3 py-2 rounded-lg bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-gray-900 transition">
                    🎨 Couleur aléatoire du titre
                </button>

                {# Console visuelle : trace le cycle de vie et les actions #}
                <div data-demo-target="log"
                     class="h-32 overflow-y-auto bg-black/60 rounded-lg p-2 space-y-0.5">
                    <div class="font-mono text-xs text-gray-500">// console du contrôleur — recharge/Turbo pour voir disconnect()</div>
                </div>
            </section>

            <p class="mt-6 text-sm text-gray-400">
                Liens temporaires — les pages d'authentification seront disponibles prochainement.
            </p>
        </div>
    </main>
{% endblock %}
