# ============================================================
# Conventio2 - environnement de production (Docker Compose)
# ============================================================
# Sur le serveur :
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
# puis renseignez les valeurs ci-dessous.
# .env.prod n'est PAS versionné (voir .gitignore) : ne le commitez jamais.

# --- Domaine public -------------------------------------------------
# Le certificat TLS est obtenu et renouvelé automatiquement par Caddy.
# Le DNS doit pointer vers le serveur, ports 80 et 443 (TCP+UDP) ouverts.
SERVER_NAME=conventio2.mon-domaine.fr
#DEFAULT_URI=https://conventio2.mon-domaine.fr

# --- Application Symfony -------------------------------------------
# Génération : openssl rand -hex 32
APP_SECRET=CHANGE_MOI_hex32

# --- PostgreSQL ----------------------------------------------------
# Génération du mot de passe : openssl rand -base64 24
POSTGRES_USER=conventio2
POSTGRES_PASSWORD=CHANGE_MOI_base64_24
POSTGRES_DB=conventio2
POSTGRES_VERSION=16

# --- Ports publiés -------------------------------------------------
# Utile seulement si 80/443 sont déjà occupés sur l'hôte.
#HTTP_PORT=8080
#HTTPS_PORT=8443

# --- Mailer (optionnel) --------------------------------------------
# Exemple SMTP : smtp://utilisateur:motdepasse@smtp.fournisseur.fr:587
# Laissez commenté pour garder null://null (emails ignorés).
#MAILER_DSN=smtp://utilisateur:motdepasse@smtp.fournisseur.fr:587
