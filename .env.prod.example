# ============================================================
# Conventio2 - environnement de production (Docker Compose)
# ============================================================
# Sur le serveur :
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
# puis renseignez les valeurs ci-dessous.
# .env.prod n'est PAS versionné (voir .gitignore) : ne le commitez jamais.

# --- Domaines et reverse-proxy -------------------------------------
# Le serveur est interne : Caddy sert du HTTP simple (préfixe http:// dans
# SERVER_NAME), le HTTPS public est terminé sur le reverse-proxy de
# l'établissement. SERVER_NAME doit pointer (DNS interne) vers CE serveur.
SERVER_NAME=http://conventio-dev.bts-sio.local
# URL publique par laquelle l'application est joignable (via le reverse-proxy)
DEFAULT_URI=https://conventio-dev.lycee-faure.fr
# IP du reverse-proxy : seuls ses en-têtes X-Forwarded-* sont considérés
# comme fiables. Ne jamais mettre * .
TRUSTED_PROXIES=IP_DU_REVERSE_PROXY

# --- Application Symfony -------------------------------------------
# Génération : openssl rand -hex 32
APP_SECRET=CHANGE_MOI_hex32

# --- PostgreSQL ----------------------------------------------------
# Génération du mot de passe : openssl rand -base64 24
POSTGRES_USER=conventio2
POSTGRES_PASSWORD=CHANGE_MOI_base64_24
POSTGRES_DB=conventio2
POSTGRES_VERSION=16

# --- Ports publiés -------------------------------------------------
# Utile seulement si le port 80 est déjà occupé sur l'hôte.
#HTTP_PORT=8080

# --- Mailer (optionnel) --------------------------------------------
# Exemple SMTP : smtp://utilisateur:motdepasse@smtp.fournisseur.fr:587
# Laissez commenté pour garder null://null (emails ignorés).
#MAILER_DSN=smtp://utilisateur:motdepasse@smtp.fournisseur.fr:587
